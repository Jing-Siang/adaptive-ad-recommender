# --- LLM / embeddings providers ---
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# --- Vector store ---
PINECONE_API_KEY=
PINECONE_INDEX_NAME=adaptive-ad-recommender
PINECONE_ENVIRONMENT=

# --- Relational store (advertisers, campaigns, review decisions, budget) ---
DATABASE_URL=postgresql+psycopg://ad_recommender:ad_recommender@localhost:5432/ad_recommender

# --- Job queue (async campaign review) ---
REDIS_URL=redis://localhost:6379

# --- Model selection ---
CLAUDE_MODEL=claude-sonnet-5
VOYAGE_INDEX_MODEL=voyage-4-large
VOYAGE_QUERY_MODEL=voyage-4-lite

# --- MCP: policy review agent fetches the ad-policy resource from this server ---
AD_POLICY_MCP_URL=

# --- Optional: MCP delivery (Slack/email) ---
SLACK_WEBHOOK_URL=
MCP_SERVER_URL=

# --- App config ---
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
