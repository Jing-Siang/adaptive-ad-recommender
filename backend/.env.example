# --- LLM / embeddings provider ---
OPENAI_API_KEY=

# --- Vector store ---
PINECONE_API_KEY=
PINECONE_INDEX_NAME=adaptive-ad-recommender

# --- Relational store (advertisers, campaigns, review decisions, budget) ---
DATABASE_URL=postgresql+psycopg://ad_recommender:ad_recommender@localhost:5432/ad_recommender

# --- Job queue (async campaign review) ---
REDIS_URL=redis://localhost:6379

# --- Kafka (CDC campaign sync to Pinecone, see docs/kafka_cdc_plan.md) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9094

# --- Model selection ---
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- App config ---
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# --- Auth (Google OAuth + our own JWT, see docs/auth_plan.md) ---
# GOOGLE_CLIENT_ID: from a Google Cloud Console OAuth client you register yourself.
# JWT_SECRET: any long random string, e.g. `openssl rand -hex 32`.
GOOGLE_CLIENT_ID=
JWT_SECRET=
